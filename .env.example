# ============================================================
# 智能聊天客服 —— 环境变量示例
# 复制本文件为 .env.local 后填写真实值：
#   cp .env.example .env.local
# 注意：.env.local 已在 .gitignore 中，绝不会被提交。
# ============================================================

# ---------- 1. 大模型厂商 ----------
# 可选：deepseek | openai | qwen | mock
#   deepseek 真实调用 DeepSeek（推荐，默认）
#   openai   调用 OpenAI 或任意 OpenAI 兼容网关
#   qwen     调用阿里云通义千问（DashScope 兼容模式）
#   mock     不需要任何 Key，返回内置假回复，仅用于本地联调/自测
MODEL_PROVIDER=deepseek

# ---------- 2. DeepSeek ----------
# 申请地址：https://platform.deepseek.com  →  API Keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---------- 3. OpenAI / 其他 OpenAI 兼容网关（MODEL_PROVIDER=openai 时生效）----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------- 4. 通义千问（MODEL_PROVIDER=qwen 时生效）----------
# 申请地址：https://bailian.console.aliyun.com  →  API-KEY
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# ---------- 5. 对话上下文 ----------
# 服务端保留最近多少轮对话（1 轮 = 一问一答），超长自动截断
MAX_CONTEXT_ROUNDS=10
# 单条用户消息最大长度（字符），超出直接拒绝
MAX_USER_MESSAGE_CHARS=1000

# ---------- 6. RAG 知识库检索 ----------
# 召回片段数量
RAG_TOP_K=3
# 余弦相似度阈值，低于该值视为「未命中」，走转人工兜底
# 本地 embedding（哈希词袋）实测建议 0.15 左右；真实 embedding 建议 0.35~0.5。
# 用 GET /api/debug/retrieval?q=你的问题 可以看到真实得分，据此调参
RAG_SCORE_THRESHOLD=0.15
# 知识切片大小（字符）与重叠（字符）
CHUNK_SIZE=300
CHUNK_OVERLAP=50

# ---------- 7. Embedding 提供方 ----------
# 可选：local | openai
#   local  零依赖本地哈希 TF-IDF 向量（默认，无需任何 Key，中英文均可）
#   openai 调用 OpenAI 兼容的 /v1/embeddings 接口，需填下面的 Key
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
